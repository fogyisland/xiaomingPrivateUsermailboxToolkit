<Window x:Class="MailConvertPrivateUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailConvertPrivateUser.Markup"
        Title="{loc:Loc Main_Title}" Height="800" Width="1420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Modern Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FA"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DatePicker Style -->
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Modern TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                            <ContentPresenter x:Name="content" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="小铭邮件百宝箱" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,16,0"/>
                </StackPanel>
                <Menu Background="Transparent" BorderThickness="0">
                    <MenuItem Header="{loc:Loc Main_Menu_File}" Padding="12,8">
                        <MenuItem Header="{loc:Loc Main_Menu_SaveSettings}" Click="SaveSettings_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Main_Menu_Exit}" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc Main_Menu_Preferences}" Padding="12,8">
                        <MenuItem Header="{loc:Loc Main_Menu_GeneralSettings}" Click="Preferences_Click"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc Main_Menu_Help}" Padding="12,8">
                        <MenuItem Header="{loc:Loc Main_Menu_Activate}" Click="Activate_Click"/>
                        <MenuItem Header="{loc:Loc Main_Menu_Register}" Click="Register_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Main_Menu_Bug}" Click="SubmitBug_Click"/>
                        <MenuItem Header="{loc:Loc Main_Menu_VisitWebsite}" Click="VisitWebsite_Click"/>
                        <MenuItem Header="{loc:Loc Main_Menu_About}" Click="About_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="8" SelectionChanged="TabControl_SelectionChanged">
            <!-- Tab 1: EML 转 PST -->
            <TabItem Header="{loc:Loc Main_Tab_EmlToPst}">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Main_Section_EmlToPst}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Loc Main_Section_EmlToPstDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>
                        <!-- Outlook 客户端提示 -->
                        <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <TextBlock Text="{loc:Loc Main_Info_OutlookRequired}" Foreground="#92400E" FontSize="11"/>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main_Field_EmlDir}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtEmlInputDir" Text="C:\emails\input"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseEmlInput_Click" Margin="12,0,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main_Field_PstOutput}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPstOutputDir" Text="C:\emails\output" Margin="0,16,0,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowsePstOutput_Click" Margin="12,16,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Main_Field_ClassifyBy}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                                <CheckBox x:Name="chkEmlByYear" Content="{loc:Loc Main_Field_ByYear}" IsChecked="True" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkEmlBySender" Content="{loc:Loc Main_Field_BySender}" Margin="0,0,20,0"/>
                                <CheckBox x:Name="chkEmlByDate" Content="{loc:Loc Main_Field_ByMonth}" Margin="0,0,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Main_Field_EstimatedCount}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblEmlEstimatedCount" Text="{loc:Loc Main_Msg_ClickScanToEstimate}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,16,0,0"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="{loc:Loc Main_Btn_Scan}" Style="{StaticResource SecondaryButton}" Click="ScanEmlFolder_Click" Margin="12,16,0,0" Padding="16,8"/>

                            <Button Grid.Row="4" Grid.Column="1" Content="{loc:Loc Main_Btn_StartConvert}" Style="{StaticResource ModernButton}" Click="ConvertEmlToPst_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                        </Grid>

                        <TextBlock x:Name="lblEmlProgress" Text="" Foreground="{StaticResource PrimaryBrush}" Margin="0,8"/>
                        <ProgressBar x:Name="progressEml" Height="20" Margin="0,8"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: EML 日期分割 -->
            <TabItem Header="{loc:Loc Main_Tab_EmlSplit}">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Main_Section_EmlSplit}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Loc Main_Section_EmlSplitDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>
                        <!-- Outlook 客户端提示 -->
                        <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <TextBlock Text="{loc:Loc Main_Info_OutlookRequired}" Foreground="#92400E" FontSize="11"/>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main_Field_EmlDir}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSplitEmlInputDir" Text="C:\emails\input"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseSplitEmlInput_Click" Margin="12,0,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main_Field_SplitDate}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dateSplit" Margin="0,16,0,0" Width="200" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Main_Field_DateBefore}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSplitBeforeDir" Text="C:\emails\before" Margin="0,16,0,0"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseSplitBefore_Click" Margin="12,16,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Main_Field_DateAfter}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtSplitAfterDir" Text="C:\emails\after" Margin="0,16,0,0"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseSplitAfter_Click" Margin="12,16,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc Main_Msg_SplitTip}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,12,0,0"/>

                            <Button Grid.Row="4" Grid.Column="1" Content="{loc:Loc Main_Btn_StartSplit}" Style="{StaticResource ModernButton}" Click="SplitEmlByDate_Click" HorizontalAlignment="Left" Margin="0,48,0,0"/>
                        </Grid>

                        <!-- 目录归类选项 -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Main_Group_DirClassifySettings}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                <TextBlock Text="{loc:Loc Main_Section_EmlSplitDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" x:Name="chkEnableClassification" Content="{loc:Loc Main_Field_EnableClassify}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Main_Field_ClassifyBy}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="2" x:Name="cboClassificationPattern" Width="180" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{loc:Loc Main_Cbo_ByYear}" Tag="Year" IsSelected="True"/>
                                        <ComboBoxItem Content="{loc:Loc Main_Cbo_BySender}" Tag="Sender"/>
                                        <ComboBoxItem Content="{loc:Loc Main_Cbo_ByRecipient}" Tag="Recipient"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Main_Field_SentMail}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc Main_Msg_UseSentTime}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,16,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="lblSplitProgress" Text="" Foreground="{StaticResource PrimaryBrush}" Margin="0,8"/>
                        <ProgressBar x:Name="progressSplit" Margin="0,8"/>

                        <!-- 邮件详情列表 -->
                        <TextBlock Text="{loc:Loc Main_Section_EmailDetails}" FontWeight="SemiBold" FontSize="16" Margin="0,32,0,12"/>
                        <DataGrid x:Name="dgEmailDetails" Height="220" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  RowBackground="White" AlternatingRowBackground="#F8FAFC" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_FileName}" Binding="{Binding FileName}" Width="150"/>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_FolderType}" Binding="{Binding FolderType}" Width="90"/>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_SentDate}" Binding="{Binding SentDateStr}" Width="140"/>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_ReceivedDate}" Binding="{Binding ReceivedDateStr}" Width="140"/>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_From}" Binding="{Binding FromAddress}" Width="150"/>
                                <DataGridTextColumn Header="{loc:Loc Main_Table_Column_Subject}" Binding="{Binding Subject}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 3: PST 提取 -->
            <TabItem Header="{loc:Loc Main_Tab_PstExtract}">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Main_Section_PstExtract}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Loc Main_Section_PstExtractDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>
                        <!-- Outlook 客户端提示 -->
                        <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <TextBlock Text="{loc:Loc Main_Info_OutlookRequired}" Foreground="#92400E" FontSize="11"/>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main_Field_PstFile}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPstInput" Text=""/>
                            <Button Grid.Row="0" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowsePstInput_Click" Margin="12,0,0,0" Padding="16,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main_Field_EmlOutput}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmlOutput" Text="C:\emails\extracted" Margin="0,16,0,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseEmlOutput_Click" Margin="12,16,0,0" Padding="16,8"/>

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Content="{loc:Loc Main_Btn_ExtractMail}" Style="{StaticResource ModernButton}" Click="ExtractPstToEml_Click" Margin="0,0,12,0"/>
                                <Button Content="{loc:Loc Main_Btn_ExtractContacts}" Style="{StaticResource SecondaryButton}" Click="ExtractPstContacts_Click" Margin="0,0,12,0"/>
                                <Button Content="{loc:Loc Main_Btn_ExtractCalendar}" Style="{StaticResource SecondaryButton}" Click="ExtractPstCalendar_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="lblPstProgress" Text="" Foreground="{StaticResource PrimaryBrush}" Margin="0,8"/>
                        <ProgressBar x:Name="progressPst" Margin="0,8"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Tab 4: OST 提取 -->
            <TabItem Header="{loc:Loc Main_Tab_OstExtract}">
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Main_Section_OstExtract}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{loc:Loc Main_Section_OstExtractDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>
                        <!-- Outlook 客户端提示 -->
                        <Border Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,16">
                            <TextBlock Text="{loc:Loc Main_Warning_CloseOutlook}" Foreground="#92400E" FontSize="11"/>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Main_Field_OstAccount}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboOstExtractStore" DisplayMemberPath="DisplayName"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main_Field_EmlOutput}" Style="{StaticResource FieldLabel}" Margin="0,16,12,0"/>
