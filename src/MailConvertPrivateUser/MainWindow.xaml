                        </Border>

                        <!-- 已登录时显示的内容 -->
                        <StackPanel x:Name="pnlO365DataContent" Visibility="Collapsed">
                            <!-- 邮件收发报表 -->
                            <TextBlock Text="{loc:Loc Main_Group_MailReport}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

