                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock Text="{loc:Loc Main_Field_NewMail}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="lblO365NewMail" Text="-" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 第二行：总数统计 -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Main_Field_SentCount}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="lblO365SentCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Main_Field_ReceivedCount}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="lblO365ReceivedCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Main_Field_ContactCount}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="lblO365ContactCount" Text="-" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 联系人管理 -->
                            <TextBlock Text="{loc:Loc Main_Group_ContactManage}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Loc Main_Btn_ExportContacts}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{loc:Loc Main_Msg_ExportContactsDesc}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Grid.Row="0" Content="{loc:Loc Main_Btn_ExportCsv}" Style="{StaticResource ModernButton}" Click="ExportO365Contacts_Click" Padding="16,8" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <StackPanel Grid.Column="0" Grid.Row="1">
                                        <TextBlock Text="{loc:Loc Main_Btn_ImportContacts}" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{loc:Loc Main_Msg_ImportContactsDesc}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                                        <Button Content="{loc:Loc Main_Btn_DownloadTemplate}" Style="{StaticResource SecondaryButton}" Click="DownloadFoxmailTemplate_Click" Padding="12,8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="{loc:Loc Main_Btn_ImportCsv}" Style="{StaticResource SecondaryButton}" Click="ImportO365Contacts_Click" Padding="16,8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 10: 邮件管理 -->
            <TabItem x:Name="tabMailManagement" Header="{loc:Loc Main_Tab_MailManagement}" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Main_Section_MailManagement}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{loc:Loc Main_Section_MailManagementDesc}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24"/>

                            <!-- 邮件导出 -->
                            <TextBlock Text="{loc:Loc Main_Group_ExportMail}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="chkExportAllMail" Content="{loc:Loc Main_Field_ExportAllMail}" VerticalAlignment="Center" Margin="0,0,0,12" Click="chkExportAllMail_Click"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Main_Field_StartDateLabel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpExportStartDate" Margin="0,0,0,12" SelectedDate="{Binding StartDate}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Main_Field_EndDateLabel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                                    <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dpExportEndDate" Margin="0,0,0,12" SelectedDate="{Binding EndDate}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Main_Field_OutputFile}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtExportPstPath" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,0,12"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="{loc:Loc Common_Browse}" Style="{StaticResource SecondaryButton}" Click="BrowseExportPath_Click" Padding="12,6" Margin="0,0,0,12"/>

                                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="chkExportByYearMonth" Content="{loc:Loc Main_Field_ClassifyByYearMonth}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="{loc:Loc Main_Btn_ExportPst}" Style="{StaticResource ModernButton}" Click="ExportO365MailByDateRange_Click" Padding="16,10" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="lblExportStatus" Text="" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <ProgressBar x:Name="progressExport" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblStatus" Text="{loc:Loc Main_Status_Ready}" Foreground="White" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Main_Field_VersionPrefix}" Foreground="White" FontSize="13" Opacity="0.8"/>
                    <TextBlock x:Name="lblVersion" Text="{loc:Loc Main_Status_Trial}" Foreground="White" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日志面板 -->
        <Border Grid.Row="3" Background="#1E1E1E" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{loc:Loc Main_Log_Title}" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Main_Btn_Clear}" Click="ClearLogPanel_Click" FontSize="10" Padding="6,2" Margin="12,0,0,0" Background="#374151" Foreground="White"/>
                </StackPanel>
                <TextBox x:Name="txtLogPanel" Grid.Row="1" IsReadOnly="True" Background="#1E1E1E" Foreground="#10B981"
                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
