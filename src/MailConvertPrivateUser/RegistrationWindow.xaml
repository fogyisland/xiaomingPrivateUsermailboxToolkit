<Window x:Class="MailConvertPrivateUser.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MailConvertPrivateUser.Markup"
        Title="{loc:Loc Reg_Title}" Height="500" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- 标题 -->
                <TextBlock x:Name="lblTitle" Text="{loc:Loc Reg_Header}" FontSize="18" FontWeight="Bold"
                           Foreground="#0078D4" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 注册状态 -->
                <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="Collapsed" x:Name="pnlTrial">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Reg_Status_Current}" FontSize="14"/>
                        <TextBlock x:Name="lblStatus" Text="{loc:Loc Reg_Status_Trial}" FontSize="14" FontWeight="Bold" Foreground="Orange"/>
                        <TextBlock x:Name="lblRemainingDays" Text="" FontSize="14" Foreground="#0078D4" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 已注册信息面板 -->
                <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15" Visibility="Collapsed" x:Name="pnlRegistered">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Reg_RegPanelTitle}" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Reg_Field_UserName}" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblUserName" Text="-" Margin="0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Reg_Field_UserEmail}" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblUserEmail" Text="-" Margin="0,5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Reg_Field_Org}" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblOrg" Text="-" Margin="0,5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Reg_Field_RegDate}" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblRegDate" Text="-" Margin="0,5"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Reg_Field_ExpireDate}" FontWeight="Bold" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblExpireDate" Text="-" Margin="0,5"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Reg_Field_Mac}" FontWeight="Bold" Margin="0,5"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblMacAddress" Text="-" Margin="0,5"/>
                                <CheckBox x:Name="chkShowMac" Content="{loc:Loc Reg_Field_ShowMac}" Margin="10,5,0,0" Click="chkShowMac_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 注册表单 -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15" x:Name="pnlRegistration">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Reg_RegFormTitle}" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,15"/>
                        <TextBlock Text="{loc:Loc Reg_RegFormHint}" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Reg_Field_SoftwareName}" Margin="0,8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblSoftwareName" Text="小铭邮件百宝箱（个人版）" FontWeight="Bold" Foreground="#0078D4" Margin="0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Reg_Field_Version}" Margin="0,8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblSoftwareVersion" Text="1.2.0.0" Margin="0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Reg_Field_Mac}" Margin="0,8" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblMacAddressInput" Text="{loc:Loc Reg_Status_Detecting}" Margin="0,8"/>
                                <CheckBox x:Name="chkShowMacInput" Content="{loc:Loc Reg_Field_ShowMac}" Margin="10,8,0,0" Click="chkShowMacInput_Click"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Reg_Field_UserName}" Margin="0,8" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtUserName" Margin="0,8" Width="300" HorizontalAlignment="Left"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Reg_Field_UserEmail}" Margin="0,8" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtUserEmail" Margin="0,8" Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Reg_Field_Org}" Margin="0,8" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOrganization" Margin="0,8" Width="300" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 激活区域 -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Reg_ActivateTitle}" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,15"/>
                        <TextBlock Text="{loc:Loc Reg_ActivateHint}" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc Reg_Field_Serial}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSerialNumber" Width="250" Margin="0,0,10,0"/>
                            <Button x:Name="btnActivate" Content="{loc:Loc Reg_Activate}" Width="80" Click="BtnActivate_Click" Background="#0078D4" Foreground="White" BorderThickness="0" Padding="5"/>
                        </StackPanel>

                        <TextBlock x:Name="lblStatusMessage" Text="" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5"/>
                    </StackPanel>
                </Border>

                <!-- 按钮区域 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnRegister" Content="{loc:Loc Reg_Btn_Register}" Width="100" Height="35" Margin="5" Click="BtnRegister_Click" Background="#0078D4" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="btnUnregister" Content="{loc:Loc Reg_Btn_Unregister}" Width="100" Height="35" Margin="5" Click="BtnUnregister_Click" Background="#DC3545" Foreground="White" BorderThickness="0" Visibility="Collapsed"/>
                    <Button Content="{loc:Loc Reg_Btn_Close}" Width="100" Height="35" Margin="5" Click="BtnClose_Click" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <TextBlock x:Name="lblFinalStatus" Text="" Foreground="Gray" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
